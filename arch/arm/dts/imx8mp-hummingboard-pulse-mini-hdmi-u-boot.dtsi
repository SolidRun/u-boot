/ {
	dsi_host: dsi-host {
		compatible = "samsung,sec-mipi-dsi";
		status = "okay";
	};
};

&lcdif1 {
	status = "okay";
};

&mipi_dsi {
	/delete-property/ assigned-clocks;
	/delete-property/ assigned-clock-parents;
	/delete-property/ assigned-clock-rates;

	/*
	 * Linux imx8mp.dtsi has ports at this level,
	 * but u-boot below a ports/ node - confusing video-link driver ...
	 */
	/delete-node/ port@1;

	ports {
		port@1 {
			reg = <1>;

			dsim_to_adv7535: endpoint {
				remote-endpoint = <&adv7535_from_dsim>;
				attach-bridge;
			};
		};
	};
};
