#include "imx8mp-sec-def.h"

#include "imx8mp-u-boot.dtsi"

/ {
	wdt-reboot {
		compatible = "wdt-reboot";
		wdt = <&wdog1>;
		bootph-pre-ram;
	};
};

&gpio1 {
	bootph-pre-ram;
};

&gpio5 {
	bootph-pre-ram;
};

&i2c1 {
	bootph-pre-ram;
};

&i2c1_pins {
	bootph-pre-ram;
};

&i2c1_gpio_pins {
	bootph-pre-ram;
};

&i2c3 {
	bootph-pre-ram;

	/* enable known eeprom for board identification */
	carrier_eeprom: eeprom@57 {
		compatible = "st,24c02", "atmel,24c02";
		reg = <0x57>;
		pagesize = <1>;
		bootph-pre-ram;
	};
};

&i2c3_pins {
	bootph-pre-ram;
};

&i2c3_gpio_pins {
	bootph-pre-ram;
};

&pmic {
	bootph-pre-ram;

	regulators {
		bootph-pre-ram;
	};
};

&som_eeprom {
	pagesize = <1>;
	bootph-pre-ram;
};

&uart2 {
	bootph-pre-ram;
};

&uart2_pins {
	bootph-pre-ram;
};

&usdhc2_pins {
	bootph-pre-ram;
};

&usdhc3_pins {
	bootph-pre-ram;
};

&usdhc3 {
	bootph-pre-ram;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	assigned-clocks = <&clk IMX8MP_CLK_USDHC3>;
	assigned-clock-rates = <400000000>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_400M>;
};

&wdog1 {
	bootph-pre-ram;
};

&wdog1_pins {
	bootph-pre-ram;
};
