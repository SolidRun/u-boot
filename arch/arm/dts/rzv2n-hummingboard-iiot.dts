/dts-v1/;
#include "r9a09g056.dtsi"
#include <dt-bindings/pinctrl/rzv2n-pinctrl.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "SolidRun HummingBoard-IIoT based on r9a09g056";
	compatible = "renesas,r9a09g056";

	aliases {
		serial0 = &scif0;
		mmc0 = &sdhi0;
		mmc1 = &sdhi1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		spi0 = &xspi;
		eeprom_carrier = &eeprom_carrier;
		eeprom_som = &eeprom_som;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	firmware {
		/* for u-boot control dts only, to discover optee */
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	memory@48000000 {
		device_type = "memory";
		/* first 128MB is reserved for secure area. */
		reg = <0x0 0x48000000 0x1 0xF8000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		global_cma: linux,cma@58000000 {
			compatible = "shared-dma-pool";
			linux,cma-default;
			reusable;
			reg = <0x0 0x58000000 0x0 0x10000000>;
		};
	};

	reg_1p8v: regulator0 {
		compatible = "regulator-fixed";

		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3v: regulator1 {
		compatible = "regulator-fixed";

		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	/* SD1 card power controlled by PA3 (port 10, pin 3 = GPIO 83) */
	reg_sd1_vmmc: regulator-sd1-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "sd1-vmmc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&pinctrl 83 0>; /* PA3, active-high */
		enable-active-high;
	};

};

&extal_clk {
	clock-frequency = <24000000>;
};

&scif0 {
	status = "okay";
};

&sdhi0 {
	bus-width = <8>;
	non-removable;
	fixed-emmc-driver-type = <1>;
	status = "okay";
};

&sdhi1 {
	bus-width = <4>;
	vmmc-supply = <&reg_sd1_vmmc>;
	vqmmc-supply = <&reg_3p3v>;
	status = "okay";
};

&i2c2 {
	pinctrl-names = "default";
	status = "okay";

	eeprom_carrier: eeprom@57 {
		compatible = "st,24c02", "atmel,24c02";
		reg = <0x57>;
		pagesize = <8>;
	};

	tca6416_u20: gpio@20 {
		compatible = "ti,tca6416";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;

		/* Hold M.2 M-key PERST# asserted so the endpoint
		 * is in reset when Linux probes PCIe after reboot.
		 */
		m2-m-perst-hog {
			gpio-hog;
			gpios = <7 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "m2-m-perst";
		};

		/* Hold M.2 B-key reset asserted so the endpoint
		 * is in reset when Linux probes after reboot.
		 */
		m2-b-reset-hog {
			gpio-hog;
			gpios = <8 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "m2-b-reset";
		};
	};
};

&i2c3 {
	status = "okay";
};

&i2c6 {
	status = "okay";
};

&i2c7 {
	status = "okay";
};

&i2c8 {
	pinctrl-names = "default";
	status = "okay";

	eeprom_som: m24c02@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
	};
};

&eth0 {
	status = "okay";
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		phy0: ethernet-phy@0 {
			reg = <0>;
		};
	};
};

&xspi {
	status = "okay";

	flash@0 {
		compatible = "spi-flash", "jedec,spi-nor";
		reg = <0>;
		m25p,fast-read;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@000000 {
				label = "bl2";
				reg = <0x00000000 0x0001D200>;
				read-only;
			};
			partition@01D200 {
				label = "fip";
				reg = <0x0001D200 0x001C2E00>;
				read-only;
			};
			partition@1E0000 {
				label = "env";
				reg = <0x001E0000 0x00020000>;
			};
		};
	};
};

&ehci0 {
	status = "okay";
};

&hsusb {
	dr_mode = "otg";
	status = "okay";
};
