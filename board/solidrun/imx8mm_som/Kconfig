config TARGET_IMX8MM_SR_SOM
	bool "SolidRun i.MX8MM SoM"
	select IMX8MM
	select SUPPORT_SPL
	select IMX8M_LPDDR4
	select FSL_CAAM
	select FSL_BLOB
	select ARCH_MISC_INIT
	select SPL_CRYPTO if SPL

if TARGET_IMX8MM_SR_SOM

config SYS_BOARD
	default "imx8mm_som"

config SYS_VENDOR
	default "solidrun"

config SYS_CONFIG_NAME
	default "imx8mm_som"

config IMX_CONFIG
	default "board/freescale/imx8mm_evk/imximage-8mm.cfg"

endif
